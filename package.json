{
  "name": "graph-code-analysis",
  "displayName": "GraphIt: Code Analysis",
  "description": "Visualize code dependencies and relationships with interactive canvas graph",
  "version": "0.1.3",
  "publisher": "mlown",
  "repository": {
    "type": "git",
    "url": "https://github.com/forget-password/graph-code-analysis.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "keywords": [
    "graph",
    "architecture",
    "dependency",
    "diagram",
    "visualization",
    "react flow",
    "uml",
    "map",
    "code analysis"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "license": "MIT",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeAnalysis.analyzeFolder",
        "title": "Code Analysis: Analyze Folder"
      },
      {
        "command": "codeAnalysis.openGraph",
        "title": "Code Analysis: Open Dependency Graph"
      },
      {
        "command": "codeAnalysis.openLanguageConfig",
        "title": "Code Analysis: Open Language Config"
      },
      {
        "command": "codeAnalysis.reloadLanguageConfig",
        "title": "Code Analysis: Reload Language Config"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "graph-code-analysis-sidebar",
          "title": "Code Analysis",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "graph-code-analysis-sidebar": [
        {
          "type": "webview",
          "id": "graph-code-analysis.sidebar",
          "name": "Project Graph"
        }
      ]
    },
    "configuration": {
      "title": "Code Analysis",
      "properties": {
        "codeAnalysis.excludePatterns": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/build/**",
            "**/dist/**",
            "**/.output/**",
            "**/.vscode/**",
            "**/coverage/**",
            "**/.git/**"
          ],
          "description": "Patterns to exclude from analysis"
        },
        "codeAnalysis.maxDepth": {
          "type": "number",
          "default": 10,
          "description": "Maximum depth for file traversal"
        },
        "codeAnalysis.analysisConcurrency": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "description": "Number of files analyzed in parallel"
        },
        "codeAnalysis.languageConfigPath": {
          "type": "string",
          "default": "",
          "description": "Optional custom path for the language rule config file. Defaults to ~/config/.code-analysis/languages.json"
        },
        "codeAnalysis.theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto"
          ],
          "default": "auto",
          "description": "Graph theme"
        },
        "codeAnalysis.layout": {
          "type": "string",
          "enum": [
            "elk",
            "dagre",
            "force",
            "circular",
            "radial"
          ],
          "default": "elk",
          "description": "Default graph layout algorithm. Legacy non-layered values fall back to ELK in the React Flow view."
        }
      }
    }
  },
  "scripts": {
    "publish": "vsce publish --no-dependencies",
    "package": "vsce package --no-dependencies",
    "install:vsix": "code --install-extension ${npm_package_name}-${npm_package_version}.vsix",
    "release": "pnpm run release:patch",
    "release:patch": "npm version patch && pnpm run package && pnpm run install:vsix && git push --follow-tags",
    "release:minor": "npm version minor && pnpm run package && pnpm run install:vsix && git push --follow-tags",
    "release:major": "npm version major && pnpm run package && pnpm run install:vsix && git push --follow-tags",
    "vscode:prepublish": "pnpm run build",
    "build": "pnpm run build:extension && pnpm run build:webview",
    "build:extension": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node24",
    "build:webview": "esbuild ./src/webview/graphApp.jsx --bundle --outfile=media/graph-app.js --format=iife --platform=browser --target=es2020 --jsx=automatic --loader:.css=css --minify",
    "watch": "pnpm run watch:extension & pnpm run watch:webview",
    "watch:extension": "pnpm run build:extension -- --watch",
    "watch:webview": "pnpm run build:webview -- --watch",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "node ./dist/test/runTest.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.1",
    "dagre": "^0.8.5",
    "elkjs": "^0.11.1",
    "html-to-image": "^1.11.13",
    "jointjs": "^3.7.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "packageManager": "pnpm@10.28.0"
}
